# Environment Settings
ENV=development
DEBUG=True
LOG_LEVEL=INFO

# Backend Control Plane API
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=change-this-to-a-secure-random-key-in-production
ALLOWED_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# PostgreSQL Database
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=aiorche_db
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/aiorche_db

# Redis Cluster / Cache
REDIS_HOST=localhost
REDIS_PORT=6379

# Envoy AI Gateway xDS Server
ENVOY_XDS_HOST=localhost
ENVOY_XDS_PORT=18000
ENVOY_ADMIN_URL=http://localhost:9901

# Keycloak OIDC Authentication
KEYCLOAK_SERVER_URL=http://localhost:8080
KEYCLOAK_REALM=aiorche
KEYCLOAK_CLIENT_ID=aiorche-admin-portal
KEYCLOAK_CLIENT_SECRET=aiorche-client-secret

# Prometheus & OpenSearch
PROMETHEUS_URL=http://localhost:9090
OPENSEARCH_URL=http://localhost:9200
