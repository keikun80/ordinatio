# -*- mode: ruby -*-
# vi: set ft=ruby :

# ==============================================================================
# Ordinatio Standalone Appliance Vagrant Specification
# Targets: Rocky Linux 9, AlmaLinux 9, RHEL 9, Oracle Linux 9, CentOS Stream 9
# ==============================================================================

Vagrant.configure("2") do |config|
  # 가상머신 기본 베이스 박스 (Amazon Linux 2023 기본값, 환경변수 OS_DISTRO로 변경 가능)
  # 예: OS_DISTRO=bento/ubuntu-24.04 vagrant up
  config.vm.box = ENV['OS_DISTRO'] || ENV['EL_DISTRO'] || "bento/amazonlinux-2023"
  config.vm.hostname = "ordinatio-standalone"

  # 호스트 전용 고정 IP 네트워크
  config.vm.network "private_network", ip: "192.168.56.10"

  # 호스트 브라우저 즉시 접근을 위한 포트 포워딩
  config.vm.network "forwarded_port", guest: 5173, host: 5173, id: "frontend-ui", auto_correct: true
  config.vm.network "forwarded_port", guest: 80, host: 8081, id: "dashboard", auto_correct: true
  config.vm.network "forwarded_port", guest: 8000, host: 8000, id: "backend-api", auto_correct: true
  config.vm.network "forwarded_port", guest: 8080, host: 8080, id: "envoy-gateway", auto_correct: true
  config.vm.network "forwarded_port", guest: 9901, host: 9901, id: "envoy-admin", auto_correct: true

  # 프로젝트 소스 코드 공유 마운트
  config.vm.synced_folder "../..", "/opt/ordinatio-src", disabled: false

  # 가상머신 프로바이더 하드웨어 리소스 할당
  config.vm.provider "virtualbox" do |vb|
    vb.name = "ordinatio-standalone-appliance"
    vb.cpus = ENV['VM_CPUS'] ? ENV['VM_CPUS'].to_i : 4
    vb.memory = ENV['VM_MEMORY'] ? ENV['VM_MEMORY'].to_i : 8192
    vb.customize ["modifyvm", :id, "--natdnshostresolver1", "on"]
  end

  # Libvirt (KVM/QEMU) 프로바이더 지원 (Linux 호스트 환경)
  config.vm.provider "libvirt" do |lv|
    lv.cpus = ENV['VM_CPUS'] ? ENV['VM_CPUS'].to_i : 4
    lv.memory = ENV['VM_MEMORY'] ? ENV['VM_MEMORY'].to_i : 8192
  end

  # Parallels 프로바이더 지원 (Apple Silicon Mac 환경)
  config.vm.provider "parallels" do |prl|
    prl.cpus = ENV['VM_CPUS'] ? ENV['VM_CPUS'].to_i : 4
    prl.memory = ENV['VM_MEMORY'] ? ENV['VM_MEMORY'].to_i : 8192
  end

  # 프로비저닝: 1) 사전 요구사항 구성 -> 2) Standalone install.sh 실행
  config.vm.provision "shell", path: "provision.sh"
end

