# ==============================================================================
# AI Orchestrator Standalone Appliance Configuration Template (.env)
# Auto-generated by aiorche-installer (Stage 4 / Step 1)
# ==============================================================================

# 1. System & Deployment
ENV=production
DEBUG=false
LOG_LEVEL=INFO
DATACENTER_NAME=__DATACENTER_NAME__
CLUSTER_REGION=__CLUSTER_REGION__
DEPLOY_MODE=standalone
SEED_DEMO_DATA=false

# 2. Backend Control Plane
HOST=0.0.0.0
PORT=8000
BACKEND_PORT=8000
PROJECT_NAME=AI Orchestrator Standalone Appliance
VERSION=1.0.0
API_V1_STR=/api/v1
SECRET_KEY=__DYNAMIC_SECRET_KEY__
ALLOWED_ORIGINS=["http://localhost", "http://127.0.0.1", "http://localhost:80", "http://localhost:8080"]

# 3. Security, PII & WORM Audit Salts
PII_MASKING_SALT=__DYNAMIC_PII_SALT__
WORM_SIGNING_KEY=__DYNAMIC_WORM_KEY__

# 4. PostgreSQL Metastore
POSTGRES_USER=postgres
POSTGRES_PASSWORD=__DYNAMIC_POSTGRES_PASSWORD__
POSTGRES_DB=aiorche_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://postgres:__DYNAMIC_POSTGRES_PASSWORD__@postgres:5432/aiorche_db

# 5. Redis Quota & Rate Limit
REDIS_HOST=redis
REDIS_PORT=6379

# 6. Envoy L7 AI Gateway
ENVOY_TRAFFIC_PORT=8080
ENVOY_ADMIN_PORT=9901
ENVOY_ADMIN_URL=http://envoy:9901
ENVOY_XDS_HOST=localhost
ENVOY_XDS_PORT=18000

# 7. Frontend Admin Console
FRONTEND_PORT=80
VITE_API_URL=/api/v1
VITE_WS_URL=/api/v1/observability/ws
VITE_DATACENTER_NAME=__DATACENTER_NAME__
VITE_CLUSTER_REGION=__CLUSTER_REGION__

