# ==============================================================================
# AI Orchestrator Appliance - Master Environment Configuration Template (.env.example)
# 100% Air-Gapped Customer-Managed Infrastructure
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. System & Datacenter Metadata
# ------------------------------------------------------------------------------
ENV=development
DEBUG=true
LOG_LEVEL=INFO
DATACENTER_NAME=온프레미스 주전산센터
CLUSTER_REGION=DC-1 서울
DEPLOY_MODE=air-gap

# ------------------------------------------------------------------------------
# 2. Backend Control Plane API
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
BACKEND_PORT=8000
PROJECT_NAME=AI Orchestrator Control Plane
VERSION=0.1.0
API_V1_STR=/api/v1
SECRET_KEY=orchestrator-in-airgap-rsa4096-secret-change-in-prod
ALLOWED_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# ------------------------------------------------------------------------------
# 3. PostgreSQL Database (Metastore)
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=aiorche_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://postgres:postgres@postgres:5432/aiorche_db

# ------------------------------------------------------------------------------
# 4. Redis (Quotas & Distributed Rate Limiting)
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# 5. Envoy L7 AI Gateway
# ------------------------------------------------------------------------------
ENVOY_TRAFFIC_PORT=8080
ENVOY_ADMIN_PORT=9901
ENVOY_ADMIN_URL=http://envoy:9901
ENVOY_XDS_HOST=localhost
ENVOY_XDS_PORT=18000

# ------------------------------------------------------------------------------
# 6. Frontend Admin Console (Vite)
# ------------------------------------------------------------------------------
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8000/api/v1
VITE_WS_URL=ws://localhost:8000/api/v1/observability/ws
VITE_DATACENTER_NAME=온프레미스 주전산센터
VITE_CLUSTER_REGION=DC-1 서울

# ------------------------------------------------------------------------------
# 7. Keycloak OIDC Authentication (Optional Air-Gap SSO)
# ------------------------------------------------------------------------------
KEYCLOAK_SERVER_URL=http://localhost:8080
KEYCLOAK_REALM=aiorche
KEYCLOAK_CLIENT_ID=aiorche-admin-portal
KEYCLOAK_CLIENT_SECRET=aiorche-client-secret
