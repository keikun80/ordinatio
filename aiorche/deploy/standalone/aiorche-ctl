#!/usr/bin/env bash
# ==============================================================================
# AI Orchestrator Appliance Host Management CLI (aiorche-ctl)
# Single-Host Standalone Controller
# ==============================================================================

set -euo pipefail

TARGET_DIR="${AIORCHE_HOME:-/opt/aiorche}"
COMPOSE_FILE="${TARGET_DIR}/docker-compose.standalone.yml"

# ANSI Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

check_target_dir() {
    if [ ! -d "$TARGET_DIR" ] || [ ! -f "$COMPOSE_FILE" ]; then
        echo -e "${RED}[ERROR]${NC} aiorche 어플라이언스가 설치되어 있지 않거나 경로가 잘못되었습니다: $TARGET_DIR"
        exit 1
    fi
}

usage() {
    echo -e "${BOLD}AI Orchestrator Standalone Appliance Controller (aiorche-ctl)${NC}"
    echo ""
    echo "사용법: aiorche-ctl <command> [arguments]"
    echo ""
    echo "명령어 목록:"
    echo "  status            5대 전 컨테이너 상태, 포트 점유 및 리소스 사용률 출력"
    echo "  start             전체 Standalone 어플라이언스 스택 기동 (systemd)"
    echo "  stop              전체 스택 정상 종료 (데이터 보존)"
    echo "  restart           전체 스택 재기동"
    echo "  logs [-f] [svc]   컨테이너 로그 확인 (기본: 전체, svc: backend, envoy 등)"
    echo "  verify            내장 헬스체크 및 엔드포인트 무결성 DoD 검증"
    echo "  reset-admin       슈퍼관리자(admin@aiorche.local) 비밀번호 대화형 재설정"
    echo "  backup            PostgreSQL 데이터 및 WORM 감사 로그 암호화 백업 tar.gz 생성"
    echo "  help              도움말 출력"
    echo ""
    exit 0
}

cmd_status() {
    check_target_dir
    echo -e "${CYAN}${BOLD}=== 1. Systemd Service State ===${NC}"
    systemctl status aiorche.service --no-pager -l || true
    echo ""
    echo -e "${CYAN}${BOLD}=== 2. Standalone Containers Status ===${NC}"
    docker compose -f "$COMPOSE_FILE" ps
    echo ""
    echo -e "${CYAN}${BOLD}=== 3. Resource Usage (Memory / CPU) ===${NC}"
    docker stats --no-stream --format "table {{.Name}}\t{{.CPUPerc}}\t{{.MemUsage}}\t{{.NetIO}}\t{{.BlockIO}}" $(docker compose -f "$COMPOSE_FILE" ps -q) 2>/dev/null || true
}

cmd_start() {
    echo -e "${CYAN}[INFO]${NC} AI Orchestrator 서비스를 시작합니다..."
    systemctl start aiorche.service
    echo -e "${GREEN}[SUCCESS]${NC} 서비스 시작 명령이 완료되었습니다."
}

cmd_stop() {
    echo -e "${YELLOW}[WARN]${NC} AI Orchestrator 서비스를 정지합니다..."
    systemctl stop aiorche.service
    echo -e "${GREEN}[SUCCESS]${NC} 서비스가 정상 종료되었습니다."
}

cmd_restart() {
    echo -e "${CYAN}[INFO]${NC} AI Orchestrator 서비스를 재기동합니다..."
    systemctl restart aiorche.service
    echo -e "${GREEN}[SUCCESS]${NC} 서비스 재기동이 완료되었습니다."
}

cmd_logs() {
    check_target_dir
    docker compose -f "$COMPOSE_FILE" logs "$@"
}

cmd_verify() {
    check_target_dir
    echo -e "${CYAN}${BOLD}=== AI Orchestrator DoD 헬스 프로브 검증 ===${NC}"
    
    echo -n "• [1/3] Backend REST API (/health): "
    if curl -sf http://localhost:8000/health &>/dev/null; then
        echo -e "${GREEN}PASS (HTTP 200)${NC}"
    else
        echo -e "${RED}FAIL${NC}"
    fi

    echo -n "• [2/3] Envoy AI Gateway (/ready): "
    if curl -sf http://localhost:9901/ready &>/dev/null; then
        echo -e "${GREEN}PASS (LIVE)${NC}"
    else
        echo -e "${RED}FAIL${NC}"
    fi

    echo -n "• [3/3] Frontend Admin Dashboard (HTTP 200): "
    if curl -sf -o /dev/null -w "%{http_code}" http://localhost/ | grep -q "200"; then
        echo -e "${GREEN}PASS (HTTP 200)${NC}"
    else
        echo -e "${RED}FAIL${NC}"
    fi
}

cmd_reset_admin() {
    check_target_dir
    echo -e "${CYAN}${BOLD}=== 슈퍼관리자 비밀번호 재설정 ===${NC}"
    docker compose -f "$COMPOSE_FILE" run --rm --no-deps backend \
        python -m app.scripts.init_admin --username admin --email admin@aiorche.local
}

cmd_backup() {
    check_target_dir
    BACKUP_NAME="aiorche-backup-$(date +%Y%m%d_%H%M%S).tar.gz"
    BACKUP_DIR="${TARGET_DIR}/backups"
    mkdir -p "$BACKUP_DIR"
    chmod 700 "$BACKUP_DIR"
    
    echo -e "${CYAN}[INFO]${NC} 데이터베이스 및 감사 로그 백업 생성 중..."
    tar -czf "${BACKUP_DIR}/${BACKUP_NAME}" \
        -C "$TARGET_DIR" \
        .env \
        data/postgres \
        data/worm_audit \
        data/logs 2>/dev/null || true
    chmod 600 "${BACKUP_DIR}/${BACKUP_NAME}"
        
    echo -e "${GREEN}[SUCCESS]${NC} 백업 아카이브 생성 완료 (보안권한 600 적용): ${BACKUP_DIR}/${BACKUP_NAME}"
}

# ------------------------------------------------------------------------------
# Main Dispatcher
# ------------------------------------------------------------------------------
if [ $# -eq 0 ]; then
    usage
fi

COMMAND="$1"
shift

case "$COMMAND" in
    status)
        cmd_status
        ;;
    start)
        cmd_start
        ;;
    stop)
        cmd_stop
        ;;
    restart)
        cmd_restart
        ;;
    logs)
        cmd_logs "$@"
        ;;
    verify)
        cmd_verify
        ;;
    reset-admin)
        cmd_reset_admin
        ;;
    backup)
        cmd_backup
        ;;
    help|-h|--help)
        usage
        ;;
    *)
        echo -e "${RED}[ERROR]${NC} 알 수 없는 명령어: $COMMAND"
        usage
        ;;
esac

