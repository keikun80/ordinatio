# ==============================================================================
# Ordinatio Standalone Appliance Configuration Template (.env)
# Auto-generated by ordinatio-installer from install.conf
# ==============================================================================

# 1. System & Deployment
ENV=production
DEBUG=false
LOG_LEVEL=INFO
DATACENTER_NAME=__DATACENTER_NAME__
CLUSTER_REGION=__CLUSTER_REGION__
DEPLOY_MODE=standalone
SEED_DEMO_DATA=false
BACKEND_IMAGE=__BACKEND_IMAGE__
FRONTEND_IMAGE=__FRONTEND_IMAGE__

# 2. Backend Control Plane
HOST=0.0.0.0
PORT=__BACKEND_PORT__
BACKEND_PORT=__BACKEND_PORT__
PROJECT_NAME=Ordinatio Standalone Appliance
VERSION=1.0.2
API_V1_STR=/api/v1
SECRET_KEY=__DYNAMIC_SECRET_KEY__
ALLOWED_ORIGINS=["http://localhost", "http://127.0.0.1", "http://localhost:5173", "http://localhost:8080"]

# 3. Super Admin Credentials (Bootstrap)
INITIAL_ADMIN_USERNAME=__INITIAL_ADMIN_USERNAME__
INITIAL_ADMIN_EMAIL=__INITIAL_ADMIN_EMAIL__

# 4. Security, PII & WORM Audit Salts
PII_MASKING_SALT=__DYNAMIC_PII_SALT__
WORM_SIGNING_KEY=__DYNAMIC_WORM_KEY__

# 5. PostgreSQL Metastore
POSTGRES_USER=postgres
POSTGRES_PASSWORD=__DYNAMIC_POSTGRES_PASSWORD__
POSTGRES_DB=ordinatio_db
POSTGRES_PORT=__POSTGRES_PORT__
DATABASE_URL=postgresql+psycopg2://postgres:__DYNAMIC_POSTGRES_PASSWORD__@postgres:__POSTGRES_PORT__/ordinatio_db

# 6. Redis Quota & Rate Limit
REDIS_HOST=redis
REDIS_PORT=__REDIS_PORT__

# 7. Envoy L7 AI Gateway
ENVOY_TRAFFIC_PORT=__ENVOY_TRAFFIC_PORT__
ENVOY_ADMIN_PORT=__ENVOY_ADMIN_PORT__
ENVOY_ADMIN_URL=http://envoy:__ENVOY_ADMIN_PORT__
ENVOY_XDS_HOST=localhost
ENVOY_XDS_PORT=18000
ENVOY_INGRESS_URL=http://127.0.0.1:__ENVOY_TRAFFIC_PORT__
DOCKER_BRIDGE_GATEWAY_IP=__DOCKER_BRIDGE_GATEWAY_IP__

# 8. L7 AI Gateway Timeouts
GATEWAY_READ_TIMEOUT=__GATEWAY_READ_TIMEOUT__
GATEWAY_CONNECT_TIMEOUT=__GATEWAY_CONNECT_TIMEOUT__
MODEL_HEALTH_CHECK_DEFAULT_TIMEOUT=__MODEL_HEALTH_CHECK_DEFAULT_TIMEOUT__

# 9. Frontend Admin Console
FRONTEND_PORT=__FRONTEND_PORT__
VITE_API_URL=/api/v1
VITE_WS_URL=/api/v1/observability/ws
VITE_DATACENTER_NAME=__DATACENTER_NAME__
VITE_CLUSTER_REGION=__CLUSTER_REGION__

# 10. Reverse Proxy & AWS ELB Configuration
BEHIND_PROXY=__BEHIND_PROXY__
TRUSTED_PROXIES=__TRUSTED_PROXIES__
ENVOY_XFF_NUM_TRUSTED_HOPS=__ENVOY_XFF_NUM_TRUSTED_HOPS__
ENFORCE_SSL_REDIRECT=__ENFORCE_SSL_REDIRECT__
